# Lokale Kopie als `.env` anlegen, NIE committen (siehe .gitignore).

# Gemeinsames Secret für den Dienst-zu-Dienst-Aufruf
# Super-Admin-/Firmen-Dienste -> Firmen-/Katalogdienst (/internal/*).
INTERNAL_SERVICE_TOKEN=change-me-to-a-long-random-value

# Erster Super-Admin-Zugang (wird nur beim allerersten Start
# angelegt, wenn noch keiner existiert — siehe
# super_admin_service/bin/server.dart).
SUPER_ADMIN_BOOTSTRAP_USERNAME=kay
SUPER_ADMIN_BOOTSTRAP_PASSWORD=change-me-please

# Postgres-Zugangsdaten je Dienst (eigene DB-Instanz pro Dienst).
SUPER_ADMIN_DB_PASSWORD=change-me-super-admin-db
GLOBAL_ARTICLES_DB_PASSWORD=change-me-global-articles-db
COMPANY_USERS_DB_PASSWORD=change-me-company-users-db
