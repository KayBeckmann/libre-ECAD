# Optional local configuration: copy to .sites.env, then use --env-file .sites.env.
# Default is local access. For authorized private LAN preview use its exact IP.
SITES_BIND_ADDRESS=127.0.0.1
# Empty origins adapt to the browser host through JS using ports 8187/8188/8185.
# Configure exact HTTP(S) origins for custom ports/domains and no-JS navigation.
HOMEPAGE_ORIGIN=
WIKI_ORIGIN=
APP_ORIGIN=
